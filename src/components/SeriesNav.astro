---
interface Props {
    title: string;
    href: string;
    label: string;
    position?: number;
    total?: number;
}

const { title, href, label, position, total } = Astro.props;
---

<a class="card series-nav" href={href}>
    <span class="eyebrow">{label}</span>
    <span class="title">{title}</span>
    {position && total && (
        <span class="meta">
            Post {position} of {total}
        </span>
    )}
</a>

<style>
    .series-nav {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        max-width: 18rem;
        padding: 0.85rem 1rem;
    }

    .series-nav .eyebrow,
    .series-nav .meta {
        margin: 0;
    }

    .title {
        font-family: var(--font-serif);
        font-weight: 700;
    }
</style>
