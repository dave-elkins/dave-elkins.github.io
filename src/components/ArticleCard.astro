---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/date';
import { getSeries } from '../data/series';

interface Props {
    entry: CollectionEntry<'articles'>;
    compact?: boolean;
    showSeriesImage?: boolean;
}

const { entry, compact = false, showSeriesImage = false } = Astro.props;
const series = getSeries(entry.data.series);
const withImage = showSeriesImage && Boolean(series?.image);
---

<article class:list={['card', { 'card--compact': compact, 'card--horizontal': withImage }]}>
    <a href={`/writing/${entry.id}/`}>
        {withImage && series?.image && (
            <img
                class="card-thumb"
                src={series.image}
                alt={series.imageAlt ?? series.title}
                loading="lazy"
                decoding="async"
            />
        )}
        <div class="card__body">
            {series && (
                <p class="eyebrow">
                    {series.shortTitle} · Post {entry.data.order}
                </p>
            )}
            <h2>{entry.data.title}</h2>
            {entry.data.subtitle && <p class="subtitle">{entry.data.subtitle}</p>}
            <p>{entry.data.description}</p>
            <p class="meta">{formatDate(entry.data.date)}</p>
        </div>
    </a>
</article>
