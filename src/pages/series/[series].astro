---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { series, type SeriesInfo } from '../../data/series';

export async function getStaticPaths() {
    return series.map((item) => ({ params: { series: item.key }, props: { series: item } }));
}

interface Props {
    series: SeriesInfo;
}

const { series: currentSeries } = Astro.props;
const articles = (
    await getCollection('articles', ({ data }) => !data.draft && data.series === currentSeries.key)
).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title={currentSeries.title} description={currentSeries.description}>
    <div class="page-shell">
        <p class="eyebrow">Series · {articles.length} posts</p>
        <h1>{currentSeries.title}</h1>
        <p class="lede">{currentSeries.description}</p>
        {currentSeries.image && (
            <img
                class="series-artwork"
                src={currentSeries.image}
                alt={currentSeries.imageAlt ?? currentSeries.title}
                decoding="async"
            />
        )}
        <ol class="card-list">
            {articles.map((entry) => (
                <li>
                    <ArticleCard entry={entry} compact />
                </li>
            ))}
        </ol>
        <p>
            <a class="more-link" href="/series/">
                ← All series
            </a>
        </p>
    </div>
</BaseLayout>
