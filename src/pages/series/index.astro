---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { series } from '../../data/series';
---

<BaseLayout
    title="Series"
    description="Multi-part series by Dave Elkins on software design and legibility."
>
    <div class="page-shell">
        <p class="eyebrow">Series</p>
        <h1>Series</h1>
        <p class="lede">Longer arguments, built one post at a time.</p>
        <ul class="card-list">
            {series.map((item) => (
                <li>
                    <SeriesCard series={item} />
                </li>
            ))}
        </ul>
    </div>
</BaseLayout>
