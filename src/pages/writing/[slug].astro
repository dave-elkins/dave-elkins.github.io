---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleFooter from '../../components/ArticleFooter.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { getSeries } from '../../data/series';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
    const articles = await getCollection('articles', ({ data }) => !data.draft);
    return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
    entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const series = getSeries(entry.data.series);
const seriesArticles = series
    ? (
          await getCollection('articles', ({ data }) => !data.draft && data.series === series.key)
      ).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    : [];
const currentIndex = seriesArticles.findIndex((item) => item.id === entry.id);
const previous = currentIndex > 0 ? seriesArticles[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? seriesArticles[currentIndex + 1] : undefined;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
    <article class="page-shell">
        <header class="article-header">
            {series && (
                <p class="eyebrow">
                    <a href={`/series/${series.key}/`}>{series.title}</a>
                    {entry.data.order && ` · Post ${entry.data.order}`}
                </p>
            )}
            <h1>{entry.data.title}</h1>
            {entry.data.subtitle && <p class="subtitle">{entry.data.subtitle}</p>}
            {series?.image && (
                <img
                    class="series-artwork"
                    src={series.image}
                    alt={series.imageAlt ?? series.title}
                    decoding="async"
                />
            )}
            <p class="lede">{entry.data.description}</p>
            <p class="meta">Published {formatDate(entry.data.date)}</p>
        </header>

        <div class="prose">
            <Content />
        </div>

        <ArticleFooter originalUrl={entry.data.originalUrl} />

        {(previous || next || series) && (
            <nav class="article-nav" aria-label="Series navigation">
                {previous ? (
                    <SeriesNav
                        title={previous.data.title}
                        href={`/writing/${previous.id}/`}
                        label="Previous"
                        position={previous.data.order}
                        total={seriesArticles.length}
                    />
                ) : (
                    <span></span>
                )}
                {next ? (
                    <SeriesNav
                        title={next.data.title}
                        href={`/writing/${next.id}/`}
                        label="Next"
                        position={next.data.order}
                        total={seriesArticles.length}
                    />
                ) : (
                    series && (
                        <SeriesNav
                            title="Back to series"
                            href={`/series/${series.key}/`}
                            label="Series index"
                        />
                    )
                )}
            </nav>
        )}
    </article>
</BaseLayout>

<style>
    .article-header h1 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        margin-bottom: 0.25rem;
    }

    .article-header .meta {
        margin-top: 1.5rem;
    }
</style>
