---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { series } from '../data/series';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const recent = articles.slice(0, 5);
---

<BaseLayout
    title="Dave Elkins"
    description="Writing on software design, legibility, healthcare engineering, and the ideas behind WYSIWID and Concept Design."
>
    <div class="page-shell">
        <section class="hero narrow">
            <p class="eyebrow">Software design · Healthcare engineering · Legibility</p>
            <h1>Writing about software that people can actually understand.</h1>
            <p class="lede">
                I'm Dave Elkins, a software engineer and architect with 20+ years of experience,
                including 15 in healthcare. This is where I publish my series and articles on
                Concept Design, WYSIWID, and the long search for codebases that stay legible.
            </p>
            <p>
                <a class="more-link" href="/writing/">
                    Browse all writing →
                </a>
            </p>
        </section>

        <section aria-labelledby="series-heading">
            <h2 id="series-heading">Series</h2>
            <ul class="card-list">
                {series.map((item) => (
                    <li>
                        <SeriesCard series={item} headingLevel={3} />
                    </li>
                ))}
            </ul>
        </section>

        <section aria-labelledby="recent-heading">
            <h2 id="recent-heading">Recent writing</h2>
            <ul class="card-list">
                {recent.map((entry) => (
                    <li>
                        <ArticleCard entry={entry} compact showSeriesImage />
                    </li>
                ))}
            </ul>
            <p>
                <a class="more-link" href="/writing/">
                    More writing →
                </a>
            </p>
        </section>
    </div>
</BaseLayout>

<style>
    .hero {
        margin-bottom: 4rem;
    }

    .hero h1 {
        margin-top: 0;
    }
</style>
