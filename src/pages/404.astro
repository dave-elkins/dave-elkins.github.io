---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page could not be found on Dave Elkins' site.">
    <div class="page-shell narrow">
        <p class="eyebrow">404</p>
        <h1>That page isn't here.</h1>
        <p class="lede">
            The link may be old, or the page may have moved. Try the <a href="/">home page</a> or
            <a href="/writing/">browse all writing</a>.
        </p>
    </div>
</BaseLayout>
